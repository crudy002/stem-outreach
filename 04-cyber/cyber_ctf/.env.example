# Copy to .env.local and adjust if the leaderboard API isn't on localhost.
# See ../leaderboard-api

# Base URL of the leaderboard API.
VITE_LEADERBOARD_API_URL=http://localhost:8000

# Optional label so scores from this booth station can be told apart
# once multiple Pis share one leaderboard backend.
VITE_STATION_ID=
